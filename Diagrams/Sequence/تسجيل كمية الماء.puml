@startuml
skinparam BackgroundColor transparent
skinparam DefaultFontColor #1A365D
skinparam DefaultFontName Arial
skinparam sequence {
    ArrowColor #1A365D
    LifeLineBorderColor #1A365D
    LifeLineBackgroundColor #F0F4F8
    ParticipantBorderColor #1A365D
    ParticipantBackgroundColor #FFFFFF
    ParticipantFontColor #1A365D
    ParticipantFontSize 14
    ParticipantFontWeight bold
    ActorBorderColor #1A365D
    ActorBackgroundColor #FFFFFF
    ActorFontColor #1A365D
    DatabaseBackgroundColor #FFFFFF
    DatabaseBorderColor #1A365D
}

autonumber

' Spatial arrangement: User on the left, System on the right
actor "User" as user
participant "App Interface\n(Flutter)" as ui
participant "Backend Server\n(Python)" as backend
database "Database\n(MySQL)" as db

user -> ui : Clicks "Add Water" button
activate ui
ui --> user : Displays quantity and type options
user -> ui : Selects (e.g., 250ml, Coffee) and confirms

ui -> backend : Sends data (POST request)\n[Date format: 13/04/2026]
activate backend

backend -> backend : Validates inputs\nand calculates actual hydration rate

backend -> db : Saves new log for user
activate db
db --> backend : Confirms save
deactivate db

backend -> backend : Calculates new daily progress percentage

backend --> ui : Returns response (Success + Updated progress percentage)
deactivate backend

ui -> ui : Graphically updates progress bar
ui --> user : Displays success notification
deactivate ui

@enduml